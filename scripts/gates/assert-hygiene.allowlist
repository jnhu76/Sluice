# assert-hygiene allowlist — see AGENTS.md §9.2 and
# docs/architecture/failure-model.md §5.
#
# SITE-LEVEL entries only. Whole-file exemption is deliberately unsupported:
# an entry exempts exactly the registered added-line sites of one file, never
# the file — a new, unregistered assert-family line in an allowlisted file
# still fails the gate.
#
# Entry format (four '|' separated fields; full-line '#' comments only,
# because a registered substring may itself contain '#', e.g. `#include`):
#
#     <path-glob> | <source-line-substring> | <category> | <reason>
#
#   path-glob              fnmatch glob against the repo-relative path
#   source-line-substring  must occur as a substring of the stripped ADDED
#                          line for the exemption to apply
#   category               L9 | diagnostic | testing   (failure-model.md §5)
#   reason                 non-empty written justification
#
# Auto-allowed WITHOUT an entry here: added lines that sit inside a
# preprocessor region provably active only under
# SLUICE_ASYNC_INTERNAL_TESTING (category 3, internal-testing preconditions).
# Detection is fail-closed under-allowing: only #ifdef / #if defined(...) /
# &&-conjunctions with the macro positive qualify; #ifndef, #if !defined,
# any '||', and any unprovable form are treated as production code.
#
# The gate is changed-lines only: pre-existing sites elsewhere are
# grandfathered (backlog: issue #144). This file is for NEW lines.
#
# ---------------------------------------------------------------------------
# Category 1 — Completion L9 pattern (Debug tripwire layered on a Release
# path that already returns the documented typed error; Release is correct
# without the assert). The substring covers both result() sites (T and void
# specializations share the same source line).
include/sluice/async/completion.hpp | assert(false && "Completion::result() called before ready (L9)"); | L9 | Completion L9 tripwire: Debug assert over the Release typed fallback returning invalid_state (header contract §L9); per-site registration — other assert-family lines in this file are NOT exempt
#
# Site registrations for the async-primitive destructor tripwires
# (ADR-async-primitive-lifetime-failfast, #135 phase 6): each assert is a
# DIAGNOSTIC only — the semantic authority is the adjacent named T6
# fail-fast, active in Debug AND Release and death-tested
# (async_sync_lifetime_death_test / async_rwlock_death_test). Registered
# because the destructor rewrites made the (unchanged) assert lines added
# lines in the PR diff; per-site only — any other assert-family line in
# these files is NOT exempt.
include/sluice/async/async_mutex.hpp | assert(owner_ == nullptr && | diagnostic | ~AsyncMutex tripwire; authority is async_mutex_lifetime_fail_fast (Debug+Release, ADR-async-primitive-lifetime-failfast)
include/sluice/async/async_rwlock.hpp | assert(active_readers_ == 0 && | diagnostic | ~AsyncRwLock readers tripwire; authority is async_rwlock_lifetime_fail_fast (Debug+Release, ADR-async-primitive-lifetime-failfast)
include/sluice/async/async_rwlock.hpp | assert(!writer_active_ && | diagnostic | ~AsyncRwLock writer tripwire; authority is async_rwlock_lifetime_fail_fast (Debug+Release, ADR-async-primitive-lifetime-failfast)
include/sluice/async/condition.hpp | assert(active_waits_.load(std::memory_order::acquire) == 0 && | diagnostic | ~AsyncCondition in-flight-wait tripwire; authority is async_condition_lifetime_fail_fast (Debug+Release, ADR-async-primitive-lifetime-failfast)
include/sluice/async/wait_queue.hpp | assert(head_ == nullptr && | diagnostic | ~WaitQueue registered-waiters tripwire; authority is wait_queue_lifetime_fail_fast (Debug+Release, ADR-async-primitive-lifetime-failfast)
#
# Category 2 — pure diagnostics (assert observes an invariant proven
# elsewhere; its failure changes no returned value or state transition).
# No permanent entries; add per site with a written reason.
#
# Category 3 — internal-testing preconditions inside guarded seams are
# auto-allowed via guard detection; entries here only for seam code that
# cannot self-guard (none currently).
