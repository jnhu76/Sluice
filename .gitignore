# TLC (TLA+) transient disk state (checker fingerprint-set output)
states/
# TLC counterexample trace exploration specs (regenerated on each CEX run)
*_TTrace*.tla

# Python bytecode
__pycache__/
*.py[cod]

# Fuzz crash artifacts and transient corpus growth (gitignored; committed
# seeds live under fuzz/corpus/ and are tracked)
fuzz/artifacts/
crash-*

# Local hardening gate artifacts (scripts/hardening.sh) and its
# persistent per-target fuzz corpus growth. Runs are reproducible but bulky;
# keep them local, never tracked.
/hardening-artifacts/
/.hardening-corpus/
/.hardening.lock

# Serena (semantic code tools); tool venv lives outside the repo under uv
.serena/
.venv/

# tlc trace dumps (TLC writes counterexample dumps into the working directory)
*_TTrace*.bin

# Local configuration and credentials. Never commit live environments.
.env
.env.*
!.env.example
!.env.*.example
.npmrc
.pypirc
.netrc
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# Local coding-agent state. Preserve intentionally versioned Claude skills.
# The rest of .claude/ can contain settings.local.json permission entries,
# command history, workspace paths and other private runtime state.
.claude/*
!/.claude/skills/
!/.claude/skills/**
