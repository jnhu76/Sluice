@@ -0,0 +1,906 @@
+// #595 arm-B (BOUNDED_PROGRESS) oracles. Each test pins one obligation the
+// deferral policy newly relies on: a finite progress path for held entries
+// without a second submit, the cap bound, deferred multi-entry partial
+// submit and retryable failure reconciliation, cancel urgency, the owner /
+// witness / payload eligibility gates, the prepark residue handoff, and
+// poison/shutdown settlement of held batches. The eligibility gates are
+// falsified by the SLUICE_595_MUTANT_* builds; every RED receipt must be the
+// named assertion, not a crash or timeout.
+
+#include <sluice/async/async_io_context.hpp>
+#include <sluice/async/detail/test_access.hpp>
+#include <sluice/async/detail/uring_backend.hpp>
+#include <sluice/async/request.hpp>
+#include <sluice/file_resource.hpp>
+#include <sluice/result.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <fcntl.h>
+#include <liburing.h>
+#include <unistd.h>
+
+#ifndef SLUICE_HAS_LIBURING
+#error "the 595 bounded-progress oracle must receive SLUICE_HAS_LIBURING"
+#endif
+
+namespace {
+
+using namespace sluice::async;
+using sluice::File;
+using sluice::async::detail::TestAccess;
+
+struct Tracker {
+    const char* name;
+    int failures = 0;
+
+    void check(bool ok, const char* label) {
+        if (!ok) {
+            ++failures;
+            std::fprintf(stderr, "FAIL [%s] %s\n", name, label);
+        }
+    }
+};
+
+std::string make_temp_file(std::size_t bytes) {
+    char path[] = "/tmp/sluice_595_defer_XXXXXX";
+    const int fd = ::mkstemp(path);
+    if (fd < 0)
+        return {};
+    std::string content(bytes, 'x');
+    std::size_t written = 0;
+    while (written < bytes) {
+        const ssize_t n = ::write(fd, content.data() + written, content.size() - written);
+        if (n <= 0) {
+            ::close(fd);
+            return {};
+        }
+        written += static_cast<std::size_t>(n);
+    }
+    ::close(fd);
+    return path;
+}
+
+std::optional<File> open_file(Tracker& t, const std::string& path) {
+    auto opened = File::open(path);
+    if (!opened.has_value()) {
+        t.check(false, "fixture file opens");
+        return std::nullopt;
+    }
+    return std::optional<File>{std::move(opened.value())};
+}
+
+// A pipe-backed read cannot complete until the write end is used, so
+// "kernel-visible and un-retired" is a deterministically holdable state that
+// also satisfies the deferral witness.
+struct BlockedPipeRead {
+    int r = -1;
+    int w = -1;
+    Request<std::size_t> request;
+    std::vector<std::byte> buffer;
+
+    bool arm(AsyncIoContext& ctx) {
+        int fds[2];
+        if (::pipe(fds) != 0)
+            return false;
+        r = fds[0];
+        w = fds[1];
+        buffer.assign(4096, std::byte{0});
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(r, sluice::FileAccess::read_only), buffer.data(),
+                   buffer.size(), 0});
+        if (!submitted.has_value())
+            return false;
+        request = std::move(submitted).value();
+        return true;
+    }
+
+    void release_one_byte() {
+        const char payload = 'p';
+        const ssize_t wrote = ::write(w, &payload, 1);
+        (void)wrote;
+    }
+
+    void close_pipe() {
+        if (r >= 0)
+            ::close(r);
+        if (w >= 0)
+            ::close(w);
+        r = -1;
+        w = -1;
+    }
+};
+
+struct DriverClaim {
+    std::optional<ProgressOwner> owner;
+    explicit DriverClaim(AsyncIoContext& ctx) {
+        if (auto claimed = ctx.claim_progress_owner(); claimed.has_value())
+            owner = std::move(claimed).value();
+    }
+};
+
+// Scripted fake kernel: models consumption by moving the kernel SQ head, so
+// ledger reconciliation runs against a consistent kernel view instead of a
+// bare return code. When `prefetch_at_call` arms that submit call, it
+// consumes one SQE and then reports EAGAIN — the partial-fetch-before-error
+// hazard the reconciliation exists for.
+struct ScriptedKernel {
+    std::vector<int> script;
+    std::size_t index = 0;
+    int calls = 0;
+    int prefetch_at_call = 0;
+    int prefetched = 0;
+
+    int scripted_rc(unsigned ready) noexcept {
+        ++calls;
+        if (index < script.size())
+            return script[index++];
+        return static_cast<int>(ready);
+    }
+};
+
+int scripted_submit(void* context, ::io_uring* ring) noexcept {
+    auto* kernel = static_cast<ScriptedKernel*>(context);
+    const unsigned ready = ::io_uring_sq_ready(ring);
+    const int rc = kernel->scripted_rc(ready);
+    *ring->sq.ktail = ring->sq.sqe_tail;
+    if (kernel->prefetch_at_call == kernel->calls && ready > 0) {
+        kernel->prefetch_at_call = 0;
+        kernel->prefetched += 1;
+        *ring->sq.khead += 1;
+        return -EAGAIN;
+    }
+    if (rc > 0) {
+        const unsigned take = static_cast<unsigned>(rc) > ready ? ready : static_cast<unsigned>(rc);
+        *ring->sq.khead += take;
+        return static_cast<int>(take);
+    }
+    return rc;
+}
+
+int full_consume_submit(void*, ::io_uring* ring) noexcept {
+    const unsigned ready = ::io_uring_sq_ready(ring);
+    *ring->sq.ktail = ring->sq.sqe_tail;
+    *ring->sq.khead = ring->sq.sqe_tail;
+    return static_cast<int>(ready);
+}
+
+void wait_gate_paused(detail::ProgressSource::PauseGate& gate) {
+    std::atomic<bool>& paused = gate.paused;
+    bool seen = paused.load(std::memory_order_acquire);
+    while (!seen) {
+        paused.wait(seen, std::memory_order_acquire);
+        seen = paused.load(std::memory_order_acquire);
+    }
+}
+
+void resume_gate(detail::ProgressSource::PauseGate& gate) noexcept {
+    gate.resume.store(true, std::memory_order_release);
+    gate.resume.notify_all();
+}
+
+bool settle_with_passes(AsyncIoContext& ctx, Request<std::size_t>& request, int rounds = 512) {
+    for (int i = 0; i < rounds && !request.ready(); ++i)
+        (void)ctx.poll();
+    return request.ready();
+}
+
+// Held-batch oracle 1: with no second submit, a single progress entry flushes
+// the held batch and every held request settles through its real path. The
+// witness (pipe read) stays blocked, so the held entries are the only work a
+// pass could complete.
+bool last_deferred_item_completes_without_second_submit(Tracker& t) {
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{16, 16});
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    BlockedPipeRead witness;
+    t.check(witness.arm(ctx), "the witness pipe read is accepted");
+    t.check(raw->submit_flushes_for_test() == 1 && raw->transport_ledger_size_for_test() == 0,
+            "the first submission of a burst takes the immediate path");
+
+    const std::string path = make_temp_file(4096 * 4);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::vector<std::byte>> buffers(2, std::vector<std::byte>(4096));
+    std::vector<Request<std::size_t>> held;
+    for (int i = 0; i < 2; ++i) {
+        auto submitted = ctx.submit_read(ReadOp{
+            NativeFileRef(*file), buffers[i].data(), 4096, static_cast<std::uint64_t>(i) * 4096});
+        t.check(submitted.has_value(), "the held submission is accepted");
+        held.push_back(std::move(submitted).value());
+    }
+    t.check(raw->submit_flushes_for_test() == 1,
+            "eligible follow-on submissions hold the kernel flush");
+    t.check(raw->transport_ledger_size_for_test() == 2 && raw->sq_ready_for_test() == 2,
+            "two SQEs are prepared and held");
+
+    const auto waited = ctx.wait_one(std::chrono::seconds{5});
+    t.check(waited.has_value() && waited.value().kind ==
+                                      AsyncIoContext::ProgressWaitOutcome::Kind::progress &&
+                waited.value().completed >= 1,
+            "one wait entry progresses the held batch without a second submit");
+    for (int i = 0; i < 2; ++i) {
+        t.check(settle_with_passes(ctx, held[i]), "a held request settles");
+        if (held[i].ready()) {
+            const auto observed = held[i].take_result();
+            t.check(observed.readiness == RequestReadiness::ready && observed.result.has_value() &&
+                        observed.result.value() == 4096,
+                    "the held read returns its bytes");
+        }
+    }
+    t.check(raw->transport_ledger_size_for_test() == 0, "the ledger drains");
+
+    witness.release_one_byte();
+    t.check(settle_with_passes(ctx, witness.request), "the witness settles after its pipe write");
+    if (witness.request.ready())
+        (void)witness.request.take_result();
+    witness.request.discard();
+    for (auto& h : held)
+        h.discard();
+    witness.close_pipe();
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Held-batch oracle 2: the cap. A burst larger than the hold bound flushes
+// inline at the bound; entries below the bound accumulate and the burst never
+// leaves more than the bound waiting for a pass.
+bool cap_flushes_held_batch_inline(Tracker& t) {
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{32, 32});
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    BlockedPipeRead witness;
+    t.check(witness.arm(ctx), "the witness pipe read is accepted");
+
+    const std::string path = make_temp_file(4096 * 16);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    const std::size_t burst = UringAsyncBackend::defer_cap_for_test() + 1;
+    std::vector<std::vector<std::byte>> buffers(burst, std::vector<std::byte>(4096));
+    std::vector<Request<std::size_t>> requests;
+    for (std::size_t i = 0; i < burst; ++i) {
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(*file), buffers[i].data(), 4096,
+                   static_cast<std::uint64_t>(i) * 4096});
+        t.check(submitted.has_value(), "the burst submission is accepted");
+        requests.push_back(std::move(submitted).value());
+        if (i + 1 < UringAsyncBackend::defer_cap_for_test()) {
+            t.check(raw->submit_flushes_for_test() == 1 &&
+                        raw->transport_ledger_size_for_test() == i + 1,
+                    "below the bound the submission is held");
+        } else if (i + 1 == UringAsyncBackend::defer_cap_for_test()) {
+            t.check(raw->submit_flushes_for_test() == 2 &&
+                        raw->transport_ledger_size_for_test() == 0,
+                    "the submission that reaches the bound flushes the batch inline");
+        }
+    }
+    t.check(raw->transport_ledger_size_for_test() == 1,
+            "the post-flush submission holds again under the bound");
+
+    const auto waited = ctx.wait_one(std::chrono::seconds{5});
+    t.check(waited.has_value() && waited.value().completed >= 1, "the flushed batch completes");
+    for (auto& r : requests) {
+        t.check(settle_with_passes(ctx, r), "a burst request settles");
+        if (r.ready())
+            (void)r.take_result();
+        else
+            r.discard();
+    }
+    witness.release_one_byte();
+    t.check(settle_with_passes(ctx, witness.request), "the witness settles");
+    witness.request.discard();
+    witness.close_pipe();
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Held-batch oracle 3: a deferred multi-entry batch meets a partial submit —
+// the kernel consumed one entry and then reported a retryable failure. The
+// ledger must reconcile against the kernel head exactly: the fetched entry
+// retires through reconciliation, the tail survives to the retry, and every
+// request settles exactly once with duplicate CQEs ignored.
+bool deferred_partial_submit_reconciles_prefix_and_retries(Tracker& t) {
+    ScriptedKernel kernel;
+    kernel.prefetch_at_call = 2;
+    UringBackendSubmitTestHooks hooks;
+    hooks.context = &kernel;
+    hooks.submit = scripted_submit;
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{8, 8}, hooks);
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    const std::string path = make_temp_file(4096 * 4);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::vector<std::byte>> buffers(4, std::vector<std::byte>(4096));
+    std::vector<Request<std::size_t>> requests;
+    for (int i = 0; i < 4; ++i) {
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(*file), buffers[i].data(), 4096,
+                   static_cast<std::uint64_t>(i) * 4096});
+        t.check(submitted.has_value(), "the submission is accepted");
+        requests.push_back(std::move(submitted).value());
+    }
+    t.check(raw->submit_flushes_for_test() == 1 && raw->transport_ledger_size_for_test() == 3,
+            "the first submission flushes; three SQEs stay held");
+
+    {
+        DriverClaim claim{ctx};
+        const auto pass = ctx.poll_progress();
+        t.check(pass.has_value(), "the pass runs");
+        t.check(pass.value().dispatch_retry_remains,
+                "a partially consumed held batch advertises retry work");
+        t.check(raw->submit_flushes_for_test() == 2, "the pass-start flush ran once");
+        t.check(kernel.prefetched == 1,
+                "the retryable failure followed a one-entry kernel fetch");
+        t.check(raw->transport_ledger_size_for_test() == 2,
+                "reconciliation retired the fetched prefix, the tail survives");
+    }
+
+    for (int i = 0; i < 4; ++i) {
+        const auto cookie =
+            raw->live_cookie_for_offset_for_test(static_cast<std::uint64_t>(i) * 4096);
+        t.check(cookie.has_value(), "a live cookie exists for each accepted read");
+        if (cookie.has_value())
+            raw->inject_cqe_for_test(*cookie, 4096);
+    }
+    for (int i = 0; i < 4; ++i) {
+        t.check(settle_with_passes(ctx, requests[i]), "the request settles after its CQE");
+        if (requests[i].ready()) {
+            const auto observed = requests[i].take_result();
+            t.check(observed.readiness == RequestReadiness::ready && observed.result.has_value() &&
+                        observed.result.value() == 4096,
+                    "the read returns its bytes");
+        }
+    }
+    t.check(raw->transport_ledger_size_for_test() == 0 && raw->live_cookies_for_test() == 0,
+            "the ledger and router drain");
+
+    const auto settled_cookie = raw->live_cookie_for_offset_for_test(0);
+    t.check(!settled_cookie.has_value(), "the retired request has no live cookie");
+    raw->inject_cqe_for_test(1, 4096);
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+    t.check(raw->live_cookies_for_test() == 0, "a duplicate CQE for a retired route is ignored");
+
+    for (auto& r : requests)
+        r.discard();
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Cancel oracle: cancelling a held (dispatched, not kernel-visible) request
+// flushes the transport in the same critical section, so a cancel never waits
+// for a pass, and the request still reaches exactly one terminal whose
+// outcome matches the physical effect.
+bool cancel_of_held_request_flushes_immediately(Tracker& t) {
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{16, 16});
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    BlockedPipeRead witness;
+    t.check(witness.arm(ctx), "the witness pipe read is accepted");
+
+    const std::string path = make_temp_file(4096 * 2);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::byte> buffer(4096);
+    auto submitted = ctx.submit_read(ReadOp{NativeFileRef(*file), buffer.data(), 4096, 4096});
+    t.check(submitted.has_value(), "the held submission is accepted");
+    Request<std::size_t> held = std::move(submitted).value();
+    t.check(raw->transport_ledger_size_for_test() == 1, "the read is prepared and held");
+
+    const auto disposition = ctx.cancel(held.id());
+    t.check(disposition.has_value() && disposition.value() == CancelDisposition::requested,
+            "the cancel of a held request is requested");
+    t.check(raw->transport_ledger_size_for_test() == 2,
+            "the cancel control joins the held batch under the existing control ordering");
+
+    bool settled = false;
+    for (int i = 0; i < 512 && !settled; ++i) {
+        (void)ctx.poll();
+        settled = held.ready();
+    }
+    t.check(raw->live_control_sqes_for_test() == 0,
+            "the cancel control retires after its CQE");
+    t.check(settled, "the cancelled held request reaches exactly one terminal");
+    if (settled) {
+        const auto observed = held.take_result();
+        const bool legal_outcome =
+            observed.readiness != RequestReadiness::ready ||
+            (observed.result.has_value() && observed.result.value() == 4096) ||
+            !observed.result.has_value();
+        t.check(legal_outcome, "the terminal matches the physical effect");
+    } else {
+        held.discard();
+    }
+
+    witness.release_one_byte();
+    t.check(settle_with_passes(ctx, witness.request), "the witness settles");
+    witness.request.discard();
+    witness.close_pipe();
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Owner oracle: only the most recent progress driver's submissions defer. A
+// split-owner submitter keeps the immediate path; once that thread drives one
+// pass, its own submissions defer.
+bool owner_gate_splits_immediate_from_deferred(Tracker& t) {
+    UringBackendSubmitTestHooks hooks;
+    hooks.submit = full_consume_submit;
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{8, 8}, hooks);
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+
+    std::thread driver([&] {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    });
+    driver.join();
+
+    const std::string path = make_temp_file(4096 * 4);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::vector<std::byte>> buffers(3, std::vector<std::byte>(4096));
+    std::vector<Request<std::size_t>> requests;
+    const std::uint64_t offsets[3] = {0, 4096, 8192};
+    for (int i = 0; i < 2; ++i) {
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(*file), buffers[i].data(), 4096, offsets[i]});
+        t.check(submitted.has_value(), "the split-owner submission is accepted");
+        requests.push_back(std::move(submitted).value());
+        t.check(raw->submit_flushes_for_test() == static_cast<std::uint64_t>(i + 1) &&
+                    raw->transport_ledger_size_for_test() == 0,
+                "a split-owner submission flushes immediately");
+    }
+
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+    {
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(*file), buffers[2].data(), 4096, offsets[2]});
+        t.check(submitted.has_value(), "the successor submission after driving is accepted");
+        requests.push_back(std::move(submitted).value());
+    }
+    t.check(raw->submit_flushes_for_test() == 2 && raw->transport_ledger_size_for_test() == 1,
+            "the driving thread's own submission defers");
+
+    for (std::size_t i = 0; i < requests.size(); ++i) {
+        const auto cookie = raw->live_cookie_for_offset_for_test(offsets[i]);
+        t.check(cookie.has_value(), "a live cookie exists for the read");
+        if (cookie.has_value())
+            raw->inject_cqe_for_test(*cookie, 4096);
+    }
+    for (auto& r : requests) {
+        t.check(settle_with_passes(ctx, r), "the request settles");
+        if (r.ready())
+            (void)r.take_result();
+        else
+            r.discard();
+    }
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Witness oracle: with nothing kernel-visible and un-retired (the sequential
+// D1 shape), every submission flushes inline; deferral would strand the only
+// outstanding work behind a pass that nothing else needs.
+bool witness_gate_keeps_sequential_submissions_immediate(Tracker& t) {
+    UringBackendSubmitTestHooks hooks;
+    hooks.submit = full_consume_submit;
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{8, 8}, hooks);
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+
+    const std::string path = make_temp_file(4096 * 4);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::byte> buffer(4096);
+    for (int i = 0; i < 3; ++i) {
+        {
+            DriverClaim claim{ctx};
+            (void)ctx.poll();
+        }
+        const std::uint64_t offset = static_cast<std::uint64_t>(i) * 4096;
+        auto submitted = ctx.submit_read(ReadOp{NativeFileRef(*file), buffer.data(), 4096, offset});
+        t.check(submitted.has_value(), "the sequential submission is accepted");
+        const auto cookie = raw->live_cookie_for_offset_for_test(offset);
+        t.check(cookie.has_value(), "the cookie is live after the inline flush");
+        if (cookie.has_value())
+            raw->inject_cqe_for_test(*cookie, 4096);
+        t.check(settle_with_passes(ctx, submitted.value()), "the request settles before the next");
+        if (submitted.value().ready())
+            (void)submitted.value().take_result();
+        else
+            submitted.value().discard();
+        t.check(raw->submit_flushes_for_test() == static_cast<std::uint64_t>(i + 1),
+                "each sequential submission flushed inline");
+    }
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Payload oracle: an ineligible payload (64 KiB) keeps the immediate path
+// even for the driving thread with a live witness.
