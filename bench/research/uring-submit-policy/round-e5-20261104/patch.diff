+    owner_gate_splits_immediate_from_deferred(t);
+    witness_gate_keeps_sequential_submissions_immediate(t);
+    payload_gate_keeps_large_reads_immediate(t);
+    prepark_handoff_flushes_held_residue(t);
+    poison_with_held_batch_retires_through_failure(t);
+    shutdown_with_held_batch_settles(t);
+    if (t.failures == 0) {
+        std::printf("[uring_595_bounded_progress_test] all checks passed\n");
+        return 0;
+    }
+    std::printf("[uring_595_bounded_progress_test] %d check(s) failed\n", t.failures);
+    return 1;
+}
