+}
+
+// Control oracle: a sticky cancel intent (its control SQE could not be
+// allocated because a full held batch occupies the SQ ring) must be serviced
+// inside the same critical section as the next accepted submission — the
+// existing control ordering — so the pending obligation never waits for a
+// driven pass, and the cancelled request still settles exactly once.
+bool pending_control_intent_forces_immediate_path(Tracker& t) {
+    ScriptedKernel kernel;
+    kernel.script = {1, 0, 0, 2};
+    UringBackendSubmitTestHooks hooks;
+    hooks.context = &kernel;
+    hooks.submit = scripted_submit;
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{8, 2}, hooks);
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    const std::string path = make_temp_file(4096 * 4);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::vector<std::byte>> buffers(4, std::vector<std::byte>(4096));
+    std::vector<Request<std::size_t>> requests;
+    const std::uint64_t offsets[4] = {0, 4096, 8192, 12288};
+    for (int i = 0; i < 3; ++i) {
+        auto submitted =
+            ctx.submit_read(ReadOp{NativeFileRef(*file), buffers[i].data(), 4096, offsets[i]});
+        t.check(submitted.has_value(), "the submission is accepted");
+        requests.push_back(std::move(submitted).value());
+    }
+    t.check(raw->transport_ledger_size_for_test() == 2,
+            "two SQEs fill the two-entry SQ ring as the held batch");
+
+    const auto disposition = ctx.cancel(requests[1].id());
+    t.check(disposition.has_value() && disposition.value() == CancelDisposition::requested,
+            "the cancel of a held request is requested");
+    const auto snapshot = raw->pending_control_snapshot_for_test();
+    t.check(snapshot.authoritative_pending == 1,
+            "the un-allocatable control SQE stays a sticky intent");
+    const std::uint64_t flushes_at_intent = raw->submit_flushes_for_test();
+
+    {
+        auto submitted =
+            ctx.submit_read(ReadOp{NativeFileRef(*file), buffers[3].data(), 4096, offsets[3]});
+        t.check(submitted.has_value(), "the submission under a pending intent is accepted");
+        requests.push_back(std::move(submitted).value());
+    }
+    t.check(raw->submit_flushes_for_test() > flushes_at_intent,
+            "a pending control intent is serviced without waiting for a pass");
+
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+    const auto canceled_cookie = raw->live_cookie_for_offset_for_test(offsets[1]);
+    for (int i = 0; i < 4; ++i) {
+        const auto cookie = raw->live_cookie_for_offset_for_test(offsets[i]);
+        if (!cookie.has_value())
+            continue;
+        if (i == 1)
+            continue;
+        raw->inject_cqe_for_test(*cookie, 4096);
+    }
+    if (canceled_cookie.has_value()) {
+        raw->inject_cqe_for_test(*canceled_cookie, -ECANCELED);
+        raw->inject_cqe_for_test(static_cast<std::uint64_t>(1) << 63u | *canceled_cookie, 0);
+    }
+    for (auto& r : requests) {
+        t.check(settle_with_passes(ctx, r), "the request settles");
+        if (r.ready())
+            (void)r.take_result();
+        else
+            r.discard();
+    }
+    t.check(raw->live_cookies_for_test() == 0 && raw->live_control_sqes_for_test() == 0,
+            "the control obligation and routes retire");
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Pre-park oracle: before the owner parks, the pass that precedes the park
+// has already flushed the held batch (the residue handoff). The owner is
+// frozen at the deterministic prepark gate while the test observes the
+// flushed ledger; the wake afterwards is attributable to the released held
+// read alone because the witness pipe is never written until later.
+bool prepark_handoff_flushes_held_residue(Tracker& t) {
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{16, 16});
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    BlockedPipeRead witness;
+    t.check(witness.arm(ctx), "the witness pipe read is accepted");
+
+    BlockedPipeRead held;
+    t.check(held.arm(ctx), "the held pipe read is accepted");
+    t.check(raw->transport_ledger_size_for_test() == 1, "the held read stays unsubmitted");
+
+    detail::ProgressSource::PauseGate gate;
+    TestAccess::context_set_prepark_pause_gate(ctx, &gate);
+    std::atomic<bool> woke{false};
+    std::atomic<long long> elapsed_ms{0};
+    std::thread owner([&] {
+        DriverClaim claim{ctx};
+        const auto start = std::chrono::steady_clock::now();
+        const auto waited = ctx.wait_one(std::chrono::seconds{5});
+        elapsed_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now() - start)
+                         .count();
+        woke = waited.has_value() &&
+               waited.value().kind == AsyncIoContext::ProgressWaitOutcome::Kind::progress &&
+               waited.value().completed >= 1;
+    });
+    wait_gate_paused(gate);
+    t.check(raw->transport_ledger_size_for_test() == 0 && raw->sq_ready_for_test() == 0,
+            "the pass before the park flushed the held residue");
+    t.check(raw->live_cookies_for_test() == 2, "both reads are kernel-visible while parked");
+
+    held.release_one_byte();
+    resume_gate(gate);
+    owner.join();
+    t.check(woke.load(), "the parked owner woke on the released held read");
+    t.check(elapsed_ms.load() < 4000, "the wake arrives well inside the bound");
+
+    t.check(settle_with_passes(ctx, held.request), "the held read settles");
+    if (held.request.ready()) {
+        const auto observed = held.request.take_result();
+        t.check(observed.readiness == RequestReadiness::ready && observed.result.has_value() &&
+                    observed.result.value() == 1,
+                "the held pipe read returned its byte");
+    } else {
+        held.request.discard();
+    }
+    witness.release_one_byte();
+    t.check(settle_with_passes(ctx, witness.request), "the witness settles");
+    witness.request.discard();
+    witness.close_pipe();
+    held.close_pipe();
+    return t.failures == 0;
+}
+
+// Poison oracle: a hard submit failure on a held batch retires every held
+// entry through the failure terminal (they are provably kernel-invisible),
+// releases borrows, and poisons admission. The already-consumed first op
+// still settles through its real CQE: the reap path stays live after poison.
+bool poison_with_held_batch_retires_through_failure(Tracker& t) {
+    ScriptedKernel kernel;
+    kernel.script = {1, -EIO};
+    UringBackendSubmitTestHooks hooks;
+    hooks.context = &kernel;
+    hooks.submit = scripted_submit;
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{8, 8}, hooks);
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    const std::string path = make_temp_file(4096 * 4);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::vector<std::byte>> buffers(3, std::vector<std::byte>(4096));
+    std::vector<Request<std::size_t>> requests;
+    for (int i = 0; i < 3; ++i) {
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(*file), buffers[i].data(), 4096,
+                   static_cast<std::uint64_t>(i) * 4096});
+        t.check(submitted.has_value(), "the submission is accepted");
+        requests.push_back(std::move(submitted).value());
+    }
+    t.check(raw->transport_ledger_size_for_test() == 2,
+            "the first submission flushed inline; two SQEs stay held");
+
+    const auto first_cookie = raw->live_cookie_for_offset_for_test(0);
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    if (first_cookie.has_value())
+        raw->inject_cqe_for_test(*first_cookie, 4096);
+    std::vector<bool> settled(requests.size(), false);
+    for (int round = 0; round < 512; ++round) {
+        bool all = true;
+        for (std::size_t i = 0; i < requests.size(); ++i) {
+            if (!settled[i] && requests[i].ready())
+                settled[i] = true;
+            all = all && settled[i];
+        }
+        if (all)
+            break;
+        (void)ctx.poll();
+    }
+    for (std::size_t i = 0; i < requests.size(); ++i) {
+        t.check(settled[i], "the request settles after poison");
+        if (!settled[i]) {
+            requests[i].discard();
+        }
+    }
+    if (settled[0]) {
+        const auto observed = requests[0].take_result();
+        t.check(observed.readiness == RequestReadiness::ready && observed.result.has_value() &&
+                    observed.result.value() == 4096,
+                "the consumed op settled through its real CQE");
+    }
+    for (std::size_t i = 1; i < requests.size(); ++i) {
+        if (settled[i]) {
+            const auto observed = requests[i].take_result();
+            t.check(observed.readiness == RequestReadiness::ready && !observed.result.has_value(),
+                    "the held entry retired through the failure terminal");
+        }
+    }
+    auto rejected = ctx.submit_read(ReadOp{NativeFileRef(*file), buffers[0].data(), 4096, 0});
+    t.check(!rejected.has_value(), "admission observes the poison");
+    t.check(raw->live_cookies_for_test() == 0,
+            "the held routes retire through the failure terminal");
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
+
+// Shutdown oracle: settlement drives passes that flush a held batch, so
+// shutdown with unsubmitted entries still converges.
+bool shutdown_with_held_batch_settles(Tracker& t) {
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{16, 16});
+    UringAsyncBackend* raw = backend.get();
+    AsyncIoContext ctx = sluice::async::detail::make_context(std::move(backend));
+    {
+        DriverClaim claim{ctx};
+        (void)ctx.poll();
+    }
+
+    BlockedPipeRead witness;
+    t.check(witness.arm(ctx), "the witness pipe read is accepted");
+
+    const std::string path = make_temp_file(4096 * 4);
+    auto file = open_file(t, path);
+    if (!file.has_value())
+        return false;
+    std::vector<std::vector<std::byte>> buffers(2, std::vector<std::byte>(4096));
+    std::vector<Request<std::size_t>> held;
+    for (int i = 0; i < 2; ++i) {
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(*file), buffers[i].data(), 4096,
+                   static_cast<std::uint64_t>(i) * 4096});
+        t.check(submitted.has_value(), "the held submission is accepted");
+        held.push_back(std::move(submitted).value());
+    }
+    t.check(raw->transport_ledger_size_for_test() == 2, "two SQEs stay held");
+
+    witness.release_one_byte();
+    const auto outcome = ctx.shutdown(ShutdownPolicy::drain);
+    t.check(outcome.has_value() && outcome.value() == ShutdownOutcome::completed,
+            "shutdown flushes and settles the held batch");
+    for (auto& h : held) {
+        t.check(h.ready(), "the held request settled during shutdown");
+        if (h.ready())
+            (void)h.take_result();
+        else
+            h.discard();
+    }
+    witness.request.discard();
+    witness.close_pipe();
+    ::unlink(path.c_str());
+    return t.failures == 0;
+}
