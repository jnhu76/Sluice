diff --git a/src/async/observe_counters.hpp b/src/async/observe_counters.hpp
new file mode 100644
index 00000000..2c6dc6a9
--- /dev/null
+++ b/src/async/observe_counters.hpp
@@ -0,0 +1,196 @@
+// Test-only observation instrumentation for research #593 (Phase C).
+// Runtime-gated by SLUICE_OBSERVE=1 / SLUICE_OBSERVE_TRACE=1; when the gate is
+// off every bump is one relaxed load + branch. Never changes behavior.
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace sluice::observe {
+
+enum class C : unsigned {
+    // K1 completion -> publication -> observer
+    cqe_total = 0,
+    handle_one_cqe,
+    control_cqe,
+    finalize_terminal,
+    core_offer_terminal,
+    core_release_execution,
+    pub_pending_push,
+    pub_pending_pop,
+    publish_one,
+    core_begin_publication,
+    core_complete_publication,
+    deliver_event,
+    core_claim_observer,
+    core_retire_observer,
+    request_ready_check,
+    request_take,
+    core_consume,
+    // K2 submit -> admission -> dispatch
+    ctx_submit_read,
+    ctx_access_lock,
+    backend_validate,
+    core_reserve,
+    core_accept,
+    core_rollback,
+    prepared_write,
+    delivery_init_lock,
+    dispatch_after_accept,
+    dispatch_push,
+    dispatch_one_locked,
+    core_claim_execution,
+    dispatch_remove_exact,
+    ledger_append,
+    ledger_pop,
+    // K3 progress pass -> wakeup -> retry
+    backend_poll_progress,
+    backend_poll,
+    run_pass,
+    pass_productive,
+    pass_empty,
+    wait_one,
+    drive_admit,
+    ps_snapshot,
+    ps_wait_call,
+    ps_park_poll,
+    ps_drain_read,
+    ps_signal,
+    backend_signal,
+    probe_immediate,
+    pass_immediate_remains,
+    pass_retry_remains,
+    core_outstanding_summary,
+    core_health_failed,
+    ps_wait_health,
+    service_controls,
+    service_control_scans,
+    ps_observe_control,
+    // K4 SQE/CQE batching + kernel boundary
+    peek_batch_calls,
+    cq_ready_bound_sum,
+    batch_got_sum,
+    cqe_seen,
+    get_events,
+    submit_enter,
+    submit_sq_ready_sum,
+    submit_rc_sum,
+    submit_rc_positive,
+    router_lookup,
+    router_probe_sum,
+    reconcile_calls,
+    // sentinel
+    COUNT
+};
+
+struct alignas(64) CounterBlock {
+    std::atomic<std::uint64_t> v[static_cast<unsigned>(C::COUNT)];
+};
+
+inline CounterBlock g_obs{};
+inline std::atomic<bool> g_obs_enabled{false};
+inline std::atomic<bool> g_obs_trace_enabled{false};
+
+struct PassTraceRecord {
+    std::uint32_t cq_ready;
+    std::uint32_t reaped;
+    std::uint32_t submit_calls;
+    std::uint32_t sqes_submitted;
+    std::uint32_t published;
+    std::uint32_t pub_bound;
+};
+
+inline std::vector<PassTraceRecord>* g_obs_trace = nullptr;
+
+inline void obs_bump(C c, std::uint64_t n = 1) noexcept {
+    if (g_obs_enabled.load(std::memory_order_relaxed)) {
+        g_obs.v[static_cast<unsigned>(c)].fetch_add(n, std::memory_order_relaxed);
+    }
+}
+
+inline std::uint64_t obs_get(C c) noexcept {
+    return g_obs.v[static_cast<unsigned>(c)].load(std::memory_order_relaxed);
+}
+
+inline void obs_install() noexcept {
+    const bool counters_on = std::getenv("SLUICE_OBSERVE") != nullptr;
+    const bool trace_on = std::getenv("SLUICE_OBSERVE_TRACE") != nullptr;
+    if (counters_on) {
+        g_obs_enabled.store(true, std::memory_order_relaxed);
+    }
+    if (trace_on) {
+        g_obs_trace_enabled.store(true, std::memory_order_relaxed);
+        g_obs_enabled.store(true, std::memory_order_relaxed);
+        g_obs_trace = new std::vector<PassTraceRecord>();
+        g_obs_trace->reserve(1u << 16);
+    }
+}
+
+inline void obs_write_dump(std::FILE* f) noexcept {
+    static const char* names[static_cast<unsigned>(C::COUNT)] = {
+        "cqe_total", "handle_one_cqe", "control_cqe", "finalize_terminal",
+        "core_offer_terminal", "core_release_execution", "pub_pending_push",
+        "pub_pending_pop", "publish_one", "core_begin_publication",
+        "core_complete_publication", "deliver_event", "core_claim_observer",
+        "core_retire_observer", "request_ready_check", "request_take",
+        "core_consume", "ctx_submit_read", "ctx_access_lock", "backend_validate",
+        "core_reserve", "core_accept", "core_rollback", "prepared_write",
+        "delivery_init_lock", "dispatch_after_accept", "dispatch_push",
+        "dispatch_one_locked", "core_claim_execution", "dispatch_remove_exact",
+        "ledger_append", "ledger_pop", "backend_poll_progress", "backend_poll",
+        "run_pass", "pass_productive", "pass_empty", "wait_one", "drive_admit",
+        "ps_snapshot", "ps_wait_call", "ps_park_poll", "ps_drain_read",
+        "ps_signal", "backend_signal", "probe_immediate", "pass_immediate_remains",
+        "pass_retry_remains", "core_outstanding_summary", "core_health_failed",
+        "ps_wait_health", "service_controls", "service_control_scans",
+        "ps_observe_control", "peek_batch_calls", "cq_ready_bound_sum",
+        "batch_got_sum", "cqe_seen", "get_events", "submit_enter",
+        "submit_sq_ready_sum", "submit_rc_sum", "submit_rc_positive",
+        "router_lookup", "router_probe_sum", "reconcile_calls",
+    };
+    for (unsigned i = 0; i < static_cast<unsigned>(C::COUNT); ++i) {
+        std::fprintf(f, "OBS %s %llu\n", names[i],
+                     static_cast<unsigned long long>(g_obs.v[i].load(std::memory_order_relaxed)));
+    }
+    if (g_obs_trace != nullptr && !g_obs_trace->empty()) {
+        std::fprintf(f, "# trace cq_ready reaped submit_calls sqes_submitted published pub_bound\n");
+        for (const PassTraceRecord& r : *g_obs_trace) {
+            std::fprintf(f, "TRACE %u %u %u %u %u %u\n", r.cq_ready, r.reaped, r.submit_calls,
+                         r.sqes_submitted, r.published, r.pub_bound);
+        }
+    }
+}
+
+struct ObsDumper {
+    ~ObsDumper() {
+        if (!g_obs_enabled.load(std::memory_order_relaxed)) {
+            return;
+        }
+        const char* out = std::getenv("SLUICE_OBSERVE_OUT");
+        if (out != nullptr && *out != '\0') {
+            if (std::FILE* f = std::fopen(out, "w")) {
+                obs_write_dump(f);
+                std::fclose(f);
+                return;
+            }
+        }
+        obs_write_dump(stderr);
+    }
+};
+
+inline const bool g_obs_installed = [] {
+    obs_install();
+    static ObsDumper dumper;
+    return true;
+}();
+
+}  // namespace sluice::observe
+
+#define SLUICE_OBS_BUMP(counter) ::sluice::observe::obs_bump(::sluice::observe::C::counter)
+#define SLUICE_OBS_BUMP_N(counter, n) ::sluice::observe::obs_bump(::sluice::observe::C::counter, (n))
+#define SLUICE_OBS_USE() [[maybe_unused]] const bool k_sluice_obs_tu_anchor_ = ::sluice::observe::g_obs_installed
