diff --git a/tests/k2_e18_poison_eligibility_test.cpp b/tests/k2_e18_poison_eligibility_test.cpp
new file mode 100644
index 00000000..389cc88e
--- /dev/null
+++ b/tests/k2_e18_poison_eligibility_test.cpp
@@ -0,0 +1,262 @@
+// K2-a E18 / K4-b research oracle (#593): the deferred-transport short path
+// is eligible only while a later pass can still submit the transport. This
+// arm's gate defers the kernel flush only for a submitting thread that drives
+// progress and only with another accepted op in flight, so the oracle builds
+// that shape explicitly: a blocked read keeps the pipeline warm, the driver
+// thread's second submission is deferred, and a peer reservation is accepted
+// while the paused window is still open. The driver's pass then hits the
+// injected hard submit failure and poisons the backend; both the deferred
+// transport and the accepted-but-undispatched reservation must retire through
+// the poison terminal. The false-eligibility mutant pushes the reservation
+// and returns, so it never reaches a terminal.
+
+#include <sluice/async/async_io_context.hpp>
+#include <sluice/async/detail/uring_backend.hpp>
+#include <sluice/async/request.hpp>
+#include <sluice/error.hpp>
+#include <sluice/file_resource.hpp>
+#include <sluice/result.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <memory>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <liburing.h>
+#include <unistd.h>
+
+namespace {
+
+using namespace sluice::async;
+using sluice::IoError;
+using sluice::File;
+
+struct PoisonState {
+    std::atomic<bool> armed{false};
+    std::atomic<int> calls{0};
+};
+
+int poison_submit_hook(void* context, ::io_uring* ring) noexcept {
+    auto* state = static_cast<PoisonState*>(context);
+    state->calls.fetch_add(1, std::memory_order_relaxed);
+    if (state->armed.load(std::memory_order_acquire)) {
+        return -EIO;
+    }
+    return ::io_uring_submit(ring);
+}
+
+template <class Gate> bool wait_gate_paused(Gate& gate) {
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{5};
+    while (std::chrono::steady_clock::now() < deadline) {
+        if (gate.paused.load(std::memory_order_acquire)) {
+            return true;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds{1});
+    }
+    return gate.paused.load(std::memory_order_acquire);
+}
+
+std::string make_temp_file(const std::string& content) {
+    char path[] = "/tmp/sluice_k4b_poison_XXXXXX";
+    const int fd = ::mkstemp(path);
+    if (fd < 0) {
+        return {};
+    }
+    const ssize_t n = ::write(fd, content.data(), content.size());
+    if (n != static_cast<ssize_t>(content.size())) {
+        ::close(fd);
+        return {};
+    }
+    ::close(fd);
+    return path;
+}
+
+struct BlockedPipeRead {
+    int r = -1;
+    int w = -1;
+    Request<std::size_t> request;
+    std::vector<std::byte> buffer;
+
+    bool arm(AsyncIoContext& ctx, std::size_t bytes) {
+        int fds[2];
+        if (::pipe(fds) != 0) {
+            return false;
+        }
+        r = fds[0];
+        w = fds[1];
+        buffer.assign(bytes, std::byte{0});
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(r, sluice::FileAccess::read_only), buffer.data(), buffer.size(), 0});
+        if (!submitted.has_value()) {
+            return false;
+        }
+        request = std::move(submitted).value();
+        return true;
+    }
+
+    void release_bytes(std::size_t n) {
+        const std::string payload(n, 'p');
+        const ssize_t wrote = ::write(w, payload.data(), payload.size());
+        (void)wrote;
+    }
+
+    void close_pipe() {
+        if (r >= 0) {
+            ::close(r);
+        }
+        if (w >= 0) {
+            ::close(w);
+        }
+        r = -1;
+        w = -1;
+    }
+};
+
+bool poison_between_accept_and_dispatch_retires_the_deferred_op() {
+    PoisonState state;
+    UringBackendSubmitTestHooks hooks;
+    hooks.context = &state;
+    hooks.submit = poison_submit_hook;
+    auto owned = std::make_unique<UringAsyncBackend>(UringConfig{8, 8}, hooks);
+    UringAsyncBackend* raw = owned.get();
+    AsyncIoContext ctx = detail::make_context(std::move(owned));
+
+    const std::string path = make_temp_file("12345678");
+    if (path.empty()) {
+        return false;
+    }
+    auto opened = File::open(path);
+    ::unlink(path.c_str());
+    if (!opened.has_value()) {
+        return false;
+    }
+    File file = std::move(opened).value();
+
+    // Warm the gated shape: one blocked read in flight and the submitting
+    // thread recorded as a progress driver.
+    BlockedPipeRead in_flight;
+    if (!in_flight.arm(ctx, 4)) {
+        return false;
+    }
+    (void)raw->poll();
+    if (raw->sq_ready_for_test() != 0) {
+        return false;
+    }
+
+    // Second driver-thread submission: outstanding=2 and the driver recorded,
+    // so the kernel flush is deferred to the next pass.
+    state.armed.store(true, std::memory_order_release);
+    std::vector<std::byte> buffer_a(4, std::byte{0});
+    auto a = ctx.submit_read(ReadOp{NativeFileRef(file), buffer_a.data(), buffer_a.size(), 0});
+    if (!a.has_value()) {
+        return false;
+    }
+    if (raw->sq_ready_for_test() != 1) {
+        std::fprintf(stderr, "FAIL: the driver-thread submission was not deferred\n");
+        state.armed.store(false, std::memory_order_release);
+        in_flight.release_bytes(1);
+        return false;
+    }
+
+    UringAsyncBackend::AcceptedPreDispatchPauseGate gate;
+    raw->set_accepted_pre_dispatch_pause_gate(&gate);
+    std::vector<std::byte> buffer_b(4, std::byte{0});
+    std::optional<Request<std::size_t>> b;
+    std::thread submitter([&] {
+        auto submitted =
+            ctx.submit_read(ReadOp{NativeFileRef(file), buffer_b.data(), buffer_b.size(), 4});
+        if (submitted.has_value()) {
+            b = std::move(submitted.value());
+        }
+    });
+    if (!wait_gate_paused(gate)) {
+        std::fprintf(stderr, "FAIL: the peer reservation never reached the dispatch gate\n");
+        gate.resume.store(true, std::memory_order_release);
+        gate.resume.notify_all();
+        submitter.join();
+        raw->set_accepted_pre_dispatch_pause_gate(nullptr);
+        return false;
+    }
+
+    // The driver's pass flushes the deferred transport; the injected hard
+    // submit failure poisons the backend and retires A.
+    (void)raw->poll();
+    bool a_converged = false;
+    for (int i = 0; i < 2000 && !a_converged; ++i) {
+        a_converged = a.value().ready();
+        if (!a_converged) {
+            (void)raw->poll();
+            std::this_thread::sleep_for(std::chrono::microseconds{500});
+        }
+    }
+    if (!a_converged) {
+        std::fprintf(stderr, "FAIL: the poisoned deferred transport did not retire\n");
+        gate.resume.store(true, std::memory_order_release);
+        gate.resume.notify_all();
+        submitter.join();
+        raw->set_accepted_pre_dispatch_pause_gate(nullptr);
+        return false;
+    }
+
+    gate.resume.store(true, std::memory_order_release);
+    gate.resume.notify_all();
+    submitter.join();
+    raw->set_accepted_pre_dispatch_pause_gate(nullptr);
+    if (!b.has_value()) {
+        std::fprintf(stderr, "FAIL: the peer reservation was rejected before the poison window\n");
+        return false;
+    }
+
+    // Both the deferred transport (A) and the accepted-but-undispatched
+    // reservation (B) must converge to the poison failure.
+    bool ready = false;
+    for (int i = 0; i < 2000 && !ready; ++i) {
+        ready = a.value().ready() && b.has_value() && b->ready();
+        if (!ready) {
+            (void)raw->poll();
+            std::this_thread::sleep_for(std::chrono::microseconds{500});
+        }
+    }
+    bool ok = true;
+    if (!ready) {
+        std::fprintf(stderr,
+                     "FAIL: a reservation accepted during the poison window never reached a "
+                     "terminal (deferred work stranded)\n");
+        ok = false;
+    } else {
+        const auto observed_a = a.value().try_result();
+        const auto observed_b = b->try_result();
+        ok = !observed_a.result.has_value() &&
+             observed_a.result.error().code == IoError::Code::backend_error &&
+             !observed_b.result.has_value() &&
+             observed_b.result.error().code == IoError::Code::backend_error;
+        if (!ok) {
+            std::fprintf(stderr, "FAIL: the poison outcomes are not backend_error on both requests\n");
+        }
+    }
+
+    in_flight.release_bytes(1);
+    for (int i = 0; i < 2000 && !in_flight.request.ready(); ++i) {
+        (void)raw->poll();
+        std::this_thread::sleep_for(std::chrono::microseconds{200});
+    }
+    in_flight.request.discard();
+    in_flight.close_pipe();
+    (void)raw->poll();
+    return ok;
+}
+
+} // namespace
+
+int main() {
+    if (!poison_between_accept_and_dispatch_retires_the_deferred_op()) {
+        std::printf("[k2_e18_poison_eligibility_test] FAILED\n");
+        return 1;
+    }
+    std::printf("[k2_e18_poison_eligibility_test] poison window retires the deferred reservation\n");
+    return 0;
+}
diff --git a/tests/k4_residue_wake_test.cpp b/tests/k4_residue_wake_test.cpp
new file mode 100644
index 00000000..7f3ae483
--- /dev/null
+++ b/tests/k4_residue_wake_test.cpp
@@ -0,0 +1,194 @@
+// K4-b research oracle (#593): with kernel submission deferred to the
+// pass-start flush, the submit-side residue signal is the only wake source for
+// a prepared-but-unsubmitted SQE. This test parks the progress owner with no
+// pending CQE, arms a peer submission whose SQE stays in the ring, and asserts
+// the owner wakes and flushes it promptly (well inside the park bound). The
+// residue-signal mutant sleeps until the deadline and leaves the SQE prepared.
+
+#include <sluice/async/async_io_context.hpp>
+#include <sluice/async/detail/uring_backend.hpp>
+#include <sluice/async/request.hpp>
+#include <sluice/result.hpp>
+
+#include <chrono>
+#include <cstdio>
+#include <memory>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <unistd.h>
+
+namespace {
+
+using namespace sluice::async;
+
+using WaitKind = AsyncIoContext::ProgressWaitOutcome::Kind;
+
+struct DriverClaim {
+    std::optional<ProgressOwner> owner;
+    explicit DriverClaim(AsyncIoContext& ctx) {
+        if (auto claimed = ctx.claim_progress_owner(); claimed.has_value())
+            owner = std::move(claimed).value();
+    }
+};
+
+struct TimedWait {
+    std::optional<AsyncIoContext::ProgressWaitOutcome> value;
+    long long elapsed_ms = 0;
+};
+
+TimedWait wait_one_timed(AsyncIoContext& ctx, std::chrono::nanoseconds bound) {
+    const auto start = std::chrono::steady_clock::now();
+    TimedWait out;
+    if (auto r = ctx.wait_one(bound); r.has_value()) {
+        out.value = r.value();
+    }
+    out.elapsed_ms =
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                              start)
+            .count();
+    return out;
+}
+
+struct BlockedPipeRead {
+    int r = -1;
+    int w = -1;
+    Request<std::size_t> request;
+    std::vector<std::byte> buffer;
+
+    bool arm(AsyncIoContext& ctx, std::size_t bytes) {
+        int fds[2];
+        if (::pipe(fds) != 0) {
+            return false;
+        }
+        r = fds[0];
+        w = fds[1];
+        buffer.assign(bytes, std::byte{0});
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(r, sluice::FileAccess::read_only), buffer.data(), buffer.size(), 0});
+        if (!submitted.has_value()) {
+            return false;
+        }
+        request = std::move(submitted).value();
+        return true;
+    }
+
+    void release_bytes(std::size_t n) {
+        const std::string payload(n, 'p');
+        const ssize_t wrote = ::write(w, payload.data(), payload.size());
+        (void)wrote;
+    }
+
+    void close_pipe() {
+        if (r >= 0) {
+            ::close(r);
+        }
+        if (w >= 0) {
+            ::close(w);
+        }
+        r = -1;
+        w = -1;
+    }
+};
+
+bool deferred_submission_wakes_parked_owner() {
+    auto raw_backend = std::make_unique<UringAsyncBackend>();
+    auto* backend = raw_backend.get();
+    AsyncIoContext ctx = detail::make_context(std::move(raw_backend));
+
+    // Arm and flush the first blocked read so the owner's later park has no
+    // pending kernel event of its own.
+    BlockedPipeRead first;
+    if (!first.arm(ctx, 4)) {
+        return false;
+    }
+    {
+        auto claim = ctx.claim_progress_owner();
+        const auto pass = ctx.poll_progress();
+        if (!pass.has_value() || pass.value().completed != 0) {
+            return false;
+        }
+    }
+    if (backend->sq_ready_for_test() != 0) {
+        std::fprintf(stderr, "FAIL: the first submission was not flushed by the pass\n");
+        return false;
+    }
+
+    TimedWait driver;
+    std::thread owner([&] {
+        DriverClaim claim{ctx};
+        driver = wait_one_timed(ctx, std::chrono::milliseconds{2000});
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds{100});
+
+    BlockedPipeRead second;
+    if (!second.arm(ctx, 4)) {
+        first.release_bytes(1);
+        owner.join();
+        return false;
+    }
+    if (backend->sq_ready_for_test() != 1) {
+        std::fprintf(stderr, "FAIL: the peer SQE was not deferred (sq_ready != 1)\n");
+        first.release_bytes(1);
+        second.release_bytes(1);
+        owner.join();
+        return false;
+    }
+
+    // Oracle: the parked owner must wake from the residue signal and flush the
+    // deferred SQE well inside its 2 s bound. Without the signal no kernel
+    // event exists to wake it, so the SQE stays prepared until the deadline.
+    bool flushed_promptly = false;
+    for (int i = 0; i < 50; ++i) {
+        if (backend->sq_ready_for_test() == 0) {
+            flushed_promptly = true;
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds{10});
+    }
+
+    first.release_bytes(1);
+    second.release_bytes(1);
+    owner.join();
+
+    bool ready = false;
+    for (int i = 0; i < 2000 && !ready; ++i) {
+        ready = first.request.ready() && second.request.ready();
+        if (!ready) {
+            (void)ctx.poll_progress().value_or(ProgressPass{});
+            std::this_thread::sleep_for(std::chrono::microseconds{200});
+        }
+    }
+    const bool woken = driver.value.has_value() &&
+                       driver.value->kind == WaitKind::progress && driver.elapsed_ms < 1500;
+    const bool ok = flushed_promptly && woken && ready;
+    if (!flushed_promptly) {
+        std::fprintf(stderr,
+                     "FAIL: deferred SQE was not flushed promptly after the peer submission\n");
+    }
+    if (!woken) {
+        std::fprintf(stderr, "FAIL: the parked owner did not report progress\n");
+    }
+    if (!ready) {
+        std::fprintf(stderr, "FAIL: the blocked reads did not complete\n");
+    }
+    (void)first.request.take_result();
+    (void)second.request.take_result();
+    first.close_pipe();
+    second.close_pipe();
+    return ok;
+}
+
+} // namespace
+
+int main() {
+    const bool ok = deferred_submission_wakes_parked_owner();
+    if (!ok) {
+        std::printf("[k4_residue_wake_test] FAILED\n");
+        return 1;
+    }
+    std::printf("[k4_residue_wake_test] deferred submission wakes the parked owner\n");
+    return 0;
+}
diff --git a/tests/k4_retry_residue_wake_test.cpp b/tests/k4_retry_residue_wake_test.cpp
new file mode 100644
index 00000000..eabff2c4
--- /dev/null
+++ b/tests/k4_retry_residue_wake_test.cpp
@@ -0,0 +1,227 @@
+// K4-b research oracle (#593): a retryable kernel-flush failure (EAGAIN) on
+// the submitting thread leaves prepared transport outside the ring with no
+// kernel event of its own. The residue advert is the only wake edge for an
+// already-parked owner; the owner's next pass must retry the flush and the
+// request must still complete. The mutation that drops the residue advert
+// leaves the owner parked until its bound and the retry never runs.
+
+#include <sluice/async/async_io_context.hpp>
+#include <sluice/async/detail/test_access.hpp>
+#include <sluice/async/detail/uring_backend.hpp>
+#include <sluice/async/request.hpp>
+#include <sluice/error.hpp>
+#include <sluice/result.hpp>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <memory>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <liburing.h>
+#include <unistd.h>
+
+namespace {
+
+using namespace sluice::async;
+
+using WaitKind = AsyncIoContext::ProgressWaitOutcome::Kind;
+
+struct RetryState {
+    std::atomic<int> calls{0};
+    std::atomic<bool> fail_next{false};
+};
+
+int retry_once_submit_hook(void* context, ::io_uring* ring) noexcept {
+    auto* state = static_cast<RetryState*>(context);
+    state->calls.fetch_add(1, std::memory_order_relaxed);
+    if (state->fail_next.exchange(false, std::memory_order_acq_rel)) {
+        return -EAGAIN;
+    }
+    return ::io_uring_submit(ring);
+}
+
+struct TimedWait {
+    std::optional<AsyncIoContext::ProgressWaitOutcome> value;
+    long long elapsed_ms = 0;
+};
+
+TimedWait wait_one_timed(AsyncIoContext& ctx, std::chrono::nanoseconds bound) {
+    const auto start = std::chrono::steady_clock::now();
+    TimedWait out;
+    if (auto r = ctx.wait_one(bound); r.has_value()) {
+        out.value = r.value();
+    }
+    out.elapsed_ms = static_cast<long long>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() -
+                                                              start)
+            .count());
+    return out;
+}
+
+struct DriverClaim {
+    std::optional<ProgressOwner> owner;
+    explicit DriverClaim(AsyncIoContext& ctx) {
+        if (auto claimed = ctx.claim_progress_owner(); claimed.has_value())
+            owner = std::move(claimed).value();
+    }
+};
+
+bool wait_counter_reaches(const std::atomic<int>& v, int expected) {
+    for (int i = 0; i < 20000000 && v.load(std::memory_order_acquire) < expected; ++i)
+        std::this_thread::yield();
+    return v.load(std::memory_order_acquire) >= expected;
+}
+
+struct BlockedPipeRead {
+    int r = -1;
+    int w = -1;
+    Request<std::size_t> request;
+    std::vector<std::byte> buffer;
+
+    bool arm(AsyncIoContext& ctx, std::size_t bytes) {
+        int fds[2];
+        if (::pipe(fds) != 0)
+            return false;
+        r = fds[0];
+        w = fds[1];
+        buffer.assign(bytes, std::byte{0});
+        auto submitted = ctx.submit_read(
+            ReadOp{NativeFileRef(r, sluice::FileAccess::read_only), buffer.data(), buffer.size(), 0});
+        if (!submitted.has_value())
+            return false;
+        request = std::move(submitted).value();
+        return true;
+    }
+
+    void release_bytes(std::size_t n) {
+        const std::string payload(n, 'p');
+        const ssize_t wrote = ::write(w, payload.data(), payload.size());
+        (void)wrote;
+    }
+
+    void close_pipe() {
+        if (r >= 0)
+            ::close(r);
+        if (w >= 0)
+            ::close(w);
+        r = -1;
+        w = -1;
+    }
+};
+
+bool retryable_flush_failure_wakes_parked_owner() {
+    RetryState state;
+    UringBackendSubmitTestHooks hooks;
+    hooks.context = &state;
+    hooks.submit = retry_once_submit_hook;
+    auto backend = std::make_unique<UringAsyncBackend>(UringConfig{8, 8}, hooks);
+    AsyncIoContext ctx = detail::make_context(std::move(backend));
+
+    std::vector<BlockedPipeRead> blocked(2);
+    for (auto& r : blocked) {
+        if (!r.arm(ctx, 4))
+            return false;
+    }
+    if (state.calls.load(std::memory_order_acquire) != 2)
+        return false;
+
+    std::atomic<int> prepark{0};
+    detail::TestAccess::context_set_progress_prepark_counter(ctx, &prepark);
+
+    TimedWait driver;
+    std::thread owner([&] {
+        DriverClaim claim{ctx};
+        driver = wait_one_timed(ctx, std::chrono::milliseconds{2000});
+    });
+    if (!wait_counter_reaches(prepark, 1)) {
+        for (auto& r : blocked)
+            r.release_bytes(1);
+        owner.join();
+        detail::TestAccess::context_set_progress_prepark_counter(ctx, nullptr);
+        return false;
+    }
+
+    // The submitting thread has never driven this backend's progress, so the
+    // third dispatch keeps the inline flush and its retryable failure leaves
+    // prepared transport (plus one ledger entry) outside the kernel.
+    BlockedPipeRead third;
+    state.fail_next.store(true, std::memory_order_release);
+    if (!third.arm(ctx, 4)) {
+        for (auto& r : blocked)
+            r.release_bytes(1);
+        owner.join();
+        detail::TestAccess::context_set_progress_prepark_counter(ctx, nullptr);
+        return false;
+    }
+    if (state.calls.load(std::memory_order_acquire) != 3) {
+        std::fprintf(stderr, "FAIL: the peer flush was not attempted while the owner was parked\n");
+        for (auto& r : blocked)
+            r.release_bytes(1);
+        third.release_bytes(1);
+        owner.join();
+        detail::TestAccess::context_set_progress_prepark_counter(ctx, nullptr);
+        return false;
+    }
+
+    // Oracle: the parked owner must wake from the residue advert and retry the
+    // flush (a fourth submit attempt) well inside its 2 s bound.
+    bool retried_promptly = false;
+    for (int i = 0; i < 100; ++i) {
+        if (state.calls.load(std::memory_order_acquire) >= 4) {
+            retried_promptly = true;
+            break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds{5});
+    }
+
+    for (auto& r : blocked)
+        r.release_bytes(1);
+    third.release_bytes(1);
+    owner.join();
+    detail::TestAccess::context_set_progress_prepark_counter(ctx, nullptr);
+
+    bool all_ready = false;
+    for (int i = 0; i < 2000 && !all_ready; ++i) {
+        all_ready = blocked[0].request.ready() && blocked[1].request.ready() &&
+                    third.request.ready();
+        if (!all_ready) {
+            (void)ctx.poll_progress().value_or(ProgressPass{});
+            std::this_thread::sleep_for(std::chrono::microseconds{200});
+        }
+    }
+
+    const bool woken = driver.value.has_value() && driver.value->kind == WaitKind::progress;
+    const bool ok = retried_promptly && woken && all_ready;
+    if (!retried_promptly) {
+        std::fprintf(stderr,
+                     "FAIL: the residue did not wake the owner to retry the flush promptly\n");
+    }
+    if (!woken) {
+        std::fprintf(stderr, "FAIL: the parked owner did not report progress\n");
+    }
+    if (!all_ready) {
+        std::fprintf(stderr, "FAIL: the retried transport did not complete\n");
+    }
+    for (auto& r : blocked) {
+        (void)r.request.take_result();
+        r.close_pipe();
+    }
+    (void)third.request.take_result();
+    third.close_pipe();
+    return ok;
+}
+
+} // namespace
+
+int main() {
+    if (!retryable_flush_failure_wakes_parked_owner()) {
+        std::printf("[k4_retry_residue_wake_test] FAILED\n");
+        return 1;
+    }
+    std::printf("[k4_retry_residue_wake_test] retryable flush residue wakes the parked owner\n");
+    return 0;
+}
