+        bench::r3::Arm::q2,     bench::r3::Arm::q8,             bench::r3::Arm::shadow};
+    for (const bench::r3::Arm arm : arms) {
+        std::printf(" arm=%s\n", bench::r3::arm_name(arm));
+        check(correctness_arm(arm, file),
