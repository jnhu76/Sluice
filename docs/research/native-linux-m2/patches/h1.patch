@@ -45,6 +45,25 @@ struct UringRingState {
 inline constexpr std::uint64_t CONTROL_TAG = std::uint64_t{1} << 63u;
 inline constexpr std::uint64_t COOKIE_MASK = CONTROL_TAG - 1u;
 
+// Operation identity: bit 63 stays free for CONTROL_TAG, bits [48..62] carry
+// the router slot, bits [0..47] the per-backend cookie. Every consumer of the
+// operation identity (SQE user_data, cancel target, control target, transport
+// ledger) must carry this same value.
+inline constexpr unsigned ROUTER_SLOT_BITS = 15;
+inline constexpr unsigned ROUTER_SLOT_SHIFT = 48;
+inline constexpr std::uint64_t ROUTER_SLOT_MASK = (std::uint64_t{1} << ROUTER_SLOT_BITS) - 1u;
+inline constexpr std::uint64_t OPERATION_COOKIE_LIMIT = std::uint64_t{1} << ROUTER_SLOT_SHIFT;
+inline constexpr std::size_t ROUTER_SLOT_CAPACITY = std::size_t{1} << ROUTER_SLOT_BITS;
+
+inline constexpr std::uint64_t make_operation_identity(std::uint32_t router_slot,
+                                                       std::uint64_t cookie) noexcept {
+    return (static_cast<std::uint64_t>(router_slot) << ROUTER_SLOT_SHIFT) | cookie;
+}
+
+inline constexpr std::uint32_t operation_identity_slot(std::uint64_t identity) noexcept {
+    return static_cast<std::uint32_t>((identity >> ROUTER_SLOT_SHIFT) & ROUTER_SLOT_MASK);
+}
+
 inline constexpr bool is_control_cookie(std::uint64_t user_data) noexcept {
     return (user_data & CONTROL_TAG) != 0;
 }
