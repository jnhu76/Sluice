diff --git a/tests/uring_identity_envelope_test.cpp b/tests/uring_identity_envelope_test.cpp
new file mode 100644
index 00000000..1c5d04f1
--- /dev/null
+++ b/tests/uring_identity_envelope_test.cpp
@@ -0,0 +1,292 @@
+// Research-only negative controls for the M2 H1 packed router identity.
+// Not part of the product test roster: this target exists only in the
+// isolated candidate worktree and is replayed from the recorded patch.
+
+#include <sluice/async/async_io_context.hpp>
+#include <sluice/async/detail/uring_backend.hpp>
+#include <sluice/async/request.hpp>
+#include <sluice/file_resource.hpp>
+#include <sluice/result.hpp>
+
+#include <liburing.h>
+
+#include "uring_internal.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <string>
+#include <sys/wait.h>
+#include <unistd.h>
+
+namespace {
+
+using namespace sluice::async;
+
+constexpr std::uint64_t kControlTag = std::uint64_t{1} << 63u;
+constexpr std::uint64_t kCookieLimit = std::uint64_t{1} << 48u;
+constexpr std::uint64_t kSlotUnit = std::uint64_t{1} << 48u;
+
+int fake_submit_no_kernel(void*, ::io_uring* ring) noexcept {
+    const unsigned ready = ::io_uring_sq_ready(ring);
+    *ring->sq.ktail = ring->sq.sqe_tail;
+    *ring->sq.khead = ring->sq.sqe_tail;
+    return static_cast<int>(ready);
+}
+
+struct Fixture {
+    std::unique_ptr<AsyncIoContext> ctx;
+    UringAsyncBackend* raw = nullptr;
+    FILE* backing = nullptr;
+
+    static Fixture create(std::size_t capacity) {
+        Fixture made;
+        made.backing = ::tmpfile();
+        if (made.backing == nullptr)
+            return made;
+        std::byte content[4096];
+        std::memset(content, 0x5a, sizeof(content));
+        if (::fwrite(content, 1, sizeof(content), made.backing) != sizeof(content))
+            return Fixture{};
+        ::rewind(made.backing);
+        UringBackendSubmitTestHooks hooks;
+        hooks.submit = fake_submit_no_kernel;
+        auto owned = std::make_unique<UringAsyncBackend>(UringConfig{capacity, 8}, hooks);
+        made.raw = owned.get();
+        made.ctx = std::make_unique<AsyncIoContext>(detail::make_context(std::move(owned)));
+        return made;
+    }
+
+    bool ok() const { return ctx != nullptr && raw != nullptr && backing != nullptr; }
+
+    std::optional<Request<std::size_t>> submit_retry(std::uint64_t offset, std::byte* buffer) {
+        for (int attempt = 0; attempt < 200; ++attempt) {
+            auto submitted = ctx->submit_read(ReadOp{
+                NativeFileRef(::fileno(backing), sluice::FileAccess::read_only), buffer, 4, offset});
+            if (submitted.has_value())
+                return std::optional<Request<std::size_t>>(std::move(submitted).value());
+            if (submitted.error().code != sluice::IoError::Code::would_block)
+                return std::nullopt;
+            (void)ctx->poll();
+        }
+        return std::nullopt;
+    }
+};
+
+template <class F> bool dies(F&& fn) {
+    const pid_t pid = ::fork();
+    if (pid == 0) {
+        fn();
+        ::_exit(0);
+    }
+    if (pid < 0)
+        return false;
+    int status = 0;
+    if (::waitpid(pid, &status, 0) != pid)
+        return false;
+    return WIFSIGNALED(status) || (WIFEXITED(status) && WEXITSTATUS(status) != 0);
+}
+
+bool identity_round_trip_and_envelope() {
+    const std::uint64_t max_cookie = kCookieLimit - 1u;
+    const std::uint64_t max_identity = make_operation_identity(32767u, max_cookie);
+    if (max_identity >= kControlTag)
+        return false;
+    for (const std::uint32_t slot : {0u, 1u, 16383u, 32767u}) {
+        const std::uint64_t identity = make_operation_identity(slot, 0x1234u);
+        if (operation_identity_slot(identity) != slot)
+            return false;
+        if ((identity & (kCookieLimit - 1u)) != 0x1234u)
+            return false;
+    }
+    return true;
+}
+
+bool capacity_ceiling_is_explicit() {
+    bool accepted_ceiling = false;
+    bool rejected_overflow = false;
+    try {
+        UringAsyncBackend backend(UringConfig{32768, 8});
+        accepted_ceiling = backend.available();
+    } catch (...) {
+        accepted_ceiling = false;
+    }
+    try {
+        UringAsyncBackend backend(UringConfig{32769, 8});
+        (void)backend;
+    } catch (const std::invalid_argument&) {
+        rejected_overflow = true;
+    } catch (...) {
+        rejected_overflow = false;
+    }
+    return accepted_ceiling && rejected_overflow;
+}
+
+bool wrong_slot_identity_is_rejected() {
+    Fixture made = Fixture::create(1);
+    if (!made.ok())
+        return false;
+    std::byte buffer[4];
+    auto request = made.submit_retry(0, buffer);
+    if (!request.has_value())
+        return false;
+    (void)made.ctx->poll();
+    const auto identity = made.raw->live_cookie_for_offset_for_test(0);
+    if (!identity.has_value())
+        return false;
+    made.raw->inject_cqe_for_test(*identity + kSlotUnit, 4);
+    (void)made.ctx->poll();
+    if (request->ready())
+        return false;
+    made.raw->inject_cqe_for_test(*identity, 4);
+    (void)made.ctx->poll();
+    if (!request->ready())
+        return false;
+    const auto observed = request->take_result();
+    return observed.result.has_value() && observed.result.value() == 4u;
+}
+
+bool stale_identity_after_slot_reuse_is_rejected() {
+    Fixture made = Fixture::create(1);
+    if (!made.ok())
+        return false;
+    std::byte first_buffer[4];
+    std::byte second_buffer[4];
+    std::uint64_t first_identity = 0;
+    {
+        auto first = made.submit_retry(0, first_buffer);
+        if (!first.has_value())
+            return false;
+        (void)made.ctx->poll();
+        const auto identity = made.raw->live_cookie_for_offset_for_test(0);
+        if (!identity.has_value())
+            return false;
+        first_identity = *identity;
+        made.raw->inject_cqe_for_test(first_identity, 4);
+        (void)made.ctx->poll();
+        if (!first->ready())
+            return false;
+        const auto observed = first->take_result();
+        if (!observed.result.has_value() || observed.result.value() != 4u)
+            return false;
+    }
+    auto second = made.submit_retry(0, second_buffer);
+    if (!second.has_value())
+        return false;
+    (void)made.ctx->poll();
+    const auto second_identity = made.raw->live_cookie_for_offset_for_test(0);
+    if (!second_identity.has_value() || *second_identity == first_identity)
+        return false;
+    made.raw->inject_cqe_for_test(first_identity, 4);
+    (void)made.ctx->poll();
+    if (second->ready())
+        return false;
+    made.raw->inject_cqe_for_test(*second_identity, 4);
+    (void)made.ctx->poll();
+    if (!second->ready())
+        return false;
+    const auto observed = second->take_result();
+    return observed.result.has_value() && observed.result.value() == 4u;
+}
+
+bool control_target_mismatch_does_not_release_control() {
+    Fixture made = Fixture::create(2);
+    if (!made.ok())
+        return false;
+    std::byte buffer[4];
+    auto request = made.submit_retry(0, buffer);
+    if (!request.has_value())
+        return false;
+    (void)made.ctx->poll();
+    const auto identity = made.raw->live_cookie_for_offset_for_test(0);
+    if (!identity.has_value())
+        return false;
+    const auto disposition = request->cancel();
+    if (!disposition.has_value() || disposition.value() != CancelDisposition::requested)
+        return false;
+    (void)made.ctx->poll();
+    if (made.raw->live_control_sqes_for_test() != 1)
+        return false;
+    made.raw->inject_cqe_for_test(kControlTag | (*identity + kSlotUnit), 0);
+    if (made.raw->live_control_sqes_for_test() != 1)
+        return false;
+    made.raw->inject_cqe_for_test(kControlTag | *identity, 0);
+    if (made.raw->live_control_sqes_for_test() != 0)
+        return false;
+    made.raw->inject_cqe_for_test(*identity, -ECANCELED);
+    (void)made.ctx->poll();
+    if (!request->ready())
+        return false;
+    const auto observed = request->take_result();
+    return observed.readiness == RequestReadiness::ready && !observed.result.has_value() &&
+           observed.result.error().code == sluice::IoError::Code::canceled;
+}
+
+bool control_cqe_without_control_state_terminates() {
+    return dies([] {
+        Fixture made = Fixture::create(1);
+        if (!made.ok())
+            ::_exit(0);
+        std::byte buffer[4];
+        auto request = made.submit_retry(0, buffer);
+        if (!request.has_value())
+            ::_exit(0);
+        (void)made.ctx->poll();
+        const auto identity = made.raw->live_cookie_for_offset_for_test(0);
+        if (!identity.has_value())
+            ::_exit(0);
+        made.raw->inject_cqe_for_test(kControlTag | *identity, 0);
+    });
+}
+
+bool cookie_exhaustion_fails_before_aliasing() {
+    return dies([] {
+        Fixture made = Fixture::create(2);
+        if (!made.ok())
+            ::_exit(0);
+        made.raw->set_next_cookie_for_test(kCookieLimit - 1u);
+        std::byte first_buffer[4];
+        std::byte second_buffer[4];
+        auto first = made.submit_retry(0, first_buffer);
+        if (!first.has_value())
+            ::_exit(0);
+        auto second = made.submit_retry(4, second_buffer);
+        (void)second;
+    });
+}
+
+} // namespace
+
+int main() {
+    ::alarm(120);
+    struct NamedTest {
+        const char* name;
+        bool (*fn)();
+    };
+    const NamedTest tests[] = {
+        {"identity_round_trip_and_envelope", identity_round_trip_and_envelope},
+        {"capacity_ceiling_is_explicit", capacity_ceiling_is_explicit},
+        {"wrong_slot_identity_is_rejected", wrong_slot_identity_is_rejected},
+        {"stale_identity_after_slot_reuse_is_rejected",
+         stale_identity_after_slot_reuse_is_rejected},
+        {"control_target_mismatch_does_not_release_control",
+         control_target_mismatch_does_not_release_control},
+        {"control_cqe_without_control_state_terminates",
+         control_cqe_without_control_state_terminates},
+        {"cookie_exhaustion_fails_before_aliasing", cookie_exhaustion_fails_before_aliasing},
+    };
+    std::size_t passed = 0;
+    for (const NamedTest& t : tests) {
+        if (!t.fn()) {
+            std::fprintf(stderr, "FAIL: %s\n", t.name);
+            return 1;
+        }
+        ++passed;
+        std::printf("ok %s\n", t.name);
+        std::fflush(stdout);
+    }
+    std::printf("all %zu uring identity-envelope controls passed\n", passed);
+    return 0;
+}
