+    if (observed == PublicObservation::stale) {
+        request_binding_invariant_fail_fast();
+    }
+    *succeeded = outcome.succeeded;
+    *error = outcome.error;
+    *effect = outcome.effect;
+    return RequestReadiness::ready;
+}
