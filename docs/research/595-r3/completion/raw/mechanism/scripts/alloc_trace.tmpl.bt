#!/usr/bin/env bpftrace
// #595 R3 continuation allocation tracer (diagnostic lane).
// Counts libc allocation calls/bytes for the bench process only. reg() is used
// because libc ships no debug info; x86-64 SysV: arg1=di, arg2=si.

uprobe:/usr/lib64/libc.so.6:malloc
/comm == "__COMM__"/
{
  @malloc_calls = count();
  @malloc_bytes = sum(reg("di"));
}

uprobe:/usr/lib64/libc.so.6:calloc
/comm == "__COMM__"/
{
  @calloc_calls = count();
  @calloc_bytes = sum(reg("di") * reg("si"));
}

uprobe:/usr/lib64/libc.so.6:realloc
/comm == "__COMM__"/
{
  @realloc_calls = count();
  @realloc_bytes = sum(reg("si"));
}

uprobe:/usr/lib64/libc.so.6:free
/comm == "__COMM__"/
{
  @free_calls = count();
}

uprobe:/usr/lib64/libc.so.6:posix_memalign
/comm == "__COMM__"/
{
  @memalign_calls = count();
}

END
{
  printf("MECH_ALLOC_TRACE_END\n");
}
