+// R3 research arm (#595): the same bounded sliding-window caller shape with
+// the submission policy replaced by the ready-batch adapter. A0's per-item
+// scope path is untouched; here submissions bypass RequestScope (the batch
+// entry is context-level) and the oldest request is waited on with the same
+// ctx.wait_one primitive the scope itself parks in.
+PhaseResult run_pipeline_phase_r3(const PipelineParams& params, const std::string& path,
+                                  bool instrument, bool verify, bool stats_enabled,
+                                  bench::r3::Arm arm) {
+    using sluice::async::Request;
+    PhaseResult result;
+
+    auto opened = File::open(path, rw_open_existing());
+    if (!opened.has_value()) {
+        result.ok = false;
+        result.failure = "open failed: " + describe(opened.error());
+        return result;
+    }
+    File file = std::move(opened).value();
+
+    AsyncStats stats;
+    std::string backend_failure;
+    const std::size_t backend_capacity =
+        params.core_capacity != 0
+            ? params.core_capacity
+            : std::max(params.depth,
+                       params.scope_capacity != 0 ? params.scope_capacity : params.depth);
+    auto context = make_context(*params.backend, backend_capacity, params.workers,
+                                backend_failure, stats_enabled ? &stats : nullptr);
+    if (!context.has_value()) {
+        result.ok = false;
+        result.failure = "NOT_RUN_WITH_REASON: " + backend_failure;
+        return result;
+    }
+    AsyncIoContext ctx = std::move(*context);
+
+    bench::r3::Adapter adapter(ctx, arm);
+
+    const std::size_t blocks = (kFixtureBytes - params.block_size) / params.block_size;
+    std::vector<std::vector<std::byte>> buffers(
+        params.depth, std::vector<std::byte>(params.block_size));
+    for (std::size_t i = 0; i < params.depth; ++i) {
+        bench::fill_pattern(buffers[i].data(), params.block_size, 0);
+    }
+
+    struct R3Inflight {
+        Request<std::size_t> request;
+        std::size_t slot = 0;
+        std::uint64_t offset = 0;
+        double ready_ns = 0.0;
+    };
+
+    std::vector<ReadOp> ready;
+    std::vector<double> ready_ns;
+    std::vector<std::size_t> slots;
+    std::vector<Request<std::size_t>> accepted;
+    ready.reserve(params.depth);
+    ready_ns.reserve(params.depth);
+    slots.reserve(params.depth);
+    accepted.reserve(params.depth);
+
+    std::deque<R3Inflight> window;
+    std::size_t submitted = 0;
+    std::size_t completed = 0;
+    std::vector<std::size_t> free_slots(params.depth);
+    for (std::size_t i = 0; i < params.depth; ++i) {
+        free_slots[i] = i;
+    }
+
+    const auto fail = [&result](const std::string& what) {
+        result.ok = false;
+        result.failure = what;
+    };
+
+    AsyncStats before = stats;
+    const bench::TimePoint start = bench::now();
+    while (completed < params.request_count && result.ok) {
+        while (window.size() < params.depth && submitted < params.request_count) {
+            const std::size_t want =
+                std::min(params.depth - window.size(), params.request_count - submitted);
+            const std::size_t base = submitted;
+            ready.clear();
+            ready_ns.clear();
+            slots.clear();
+            for (std::size_t k = 0; k < want; ++k) {
+                const std::size_t sequence = base + k;
+                const std::size_t slot = free_slots.back();
+                free_slots.pop_back();
+                ReadOp op;
+                op.file = NativeFileRef(file);
+                op.dst = buffers[slot].data();
+                op.len = params.block_size;
+                op.offset =
+                    static_cast<std::uint64_t>(sequence % blocks) * params.block_size;
+                ready.push_back(op);
+                ready_ns.push_back(instrument ? bench::now_ns() : 0.0);
+                slots.push_back(slot);
+            }
+            auto outcome = adapter.submit(std::span<const ReadOp>(ready.data(), ready.size()),
+                                           accepted);
+            result.r3.entry_calls += outcome.counters.entry_calls;
+            result.r3.group_calls += outcome.counters.group_calls;
+            result.r3.single_calls += outcome.counters.single_calls;
+            result.r3.accepted += outcome.counters.accepted;
+            result.r3.prefix_max =
+                std::max(result.r3.prefix_max, outcome.counters.prefix_max);
+            result.r3.suffix_single_calls += outcome.counters.suffix_single_calls;
+            result.r3.flush_attempts += outcome.counters.flush_attempts;
+            result.r3.ineligible_fallbacks += outcome.counters.ineligible_fallbacks;
+            result.r3.gate_stops += outcome.counters.gate_stops;
+            result.r3.rejected_calls += outcome.counters.rejected_calls;
+            result.r3.untouched += outcome.counters.untouched;
+            if (outcome.error.has_value()) {
+                fail("r3 submit failed: " + describe(*outcome.error));
+                break;
+            }
+            if (accepted.size() != want) {
+                fail("r3 adapter disposed " + std::to_string(accepted.size()) + " of " +
+                     std::to_string(want) + " ready reads");
+                break;
+            }
+            for (std::size_t k = 0; k < want; ++k) {
+                window.push_back(
+                    R3Inflight{std::move(accepted[k]), slots[k],
+                               static_cast<std::uint64_t>((base + k) % blocks) *
+                                   params.block_size,
+                               ready_ns[k]});
+            }
+            result.counters.submits += want;
+            submitted += want;
+        }
+        if (!result.ok) {
+            break;
+        }
+        if (window.empty()) {
+            fail("pipeline stalled with an empty window at operation " +
+                 std::to_string(completed));
+            break;
+        }
+
+        R3Inflight& oldest = window.front();
+        ++result.counters.waits;
+        const auto deadline =
+            std::chrono::steady_clock::now() + kWaitDeadline;
+        for (;;) {
+            if (oldest.request.ready()) {
+                break;
+            }
+            const auto remaining = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                deadline - std::chrono::steady_clock::now());
+            if (remaining.count() <= 0) {
+                fail("wait deadline expired before the oldest request completed");
+                break;
+            }
+            auto woke = ctx.wait_one(remaining);
+            if (!woke.has_value()) {
+                fail("wait failed: " + describe(woke.error()));
+                break;
+            }
+            switch (woke.value().kind) {
+            case AsyncIoContext::ProgressWaitOutcome::Kind::progress:
+            case AsyncIoContext::ProgressWaitOutcome::Kind::deadline_expired:
+                break;
+            case AsyncIoContext::ProgressWaitOutcome::Kind::control_interrupted:
+                fail("progress wait interrupted by sticky control");
+                break;
+            case AsyncIoContext::ProgressWaitOutcome::Kind::health_failure:
+                fail("progress wait reported a health failure");
+                break;
+            }
+            if (!result.ok) {
+                break;
+            }
+        }
+        if (!result.ok) {
+            break;
+        }
+
+        const auto observed = oldest.request.take_result();
+        if (observed.readiness != RequestReadiness::ready) {
+            fail("take did not observe a ready result at operation " +
+                 std::to_string(completed));
+            break;
+        }
+        if (!observed.result.has_value()) {
+            fail("operation failed: " + describe(observed.result.error()));
+            break;
+        }
+        if (observed.result.value() != params.block_size) {
+            fail("short read: " + std::to_string(observed.result.value()) + " of " +
+                 std::to_string(params.block_size));
+            break;
+        }
+        if (instrument) {
+            result.latencies.push_back(bench::now_ns() - oldest.ready_ns);
+        }
+        if (verify) {
+            const auto mismatch = bench::verify_pattern(buffers[oldest.slot].data(),
+                                                        params.block_size, oldest.offset);
+            if (!mismatch.ok) {
+                fail("byte mismatch at absolute " +
+                     std::to_string(mismatch.first_bad_position) + " (operation " +
+                     std::to_string(completed) + ", buffer slot " +
+                     std::to_string(oldest.slot) + ", offset " +
+                     std::to_string(oldest.offset) + ")");
+                break;
+            }
+        }
+        result.bytes += observed.result.value();
+        ++result.ops;
+        ++completed;
+        free_slots.push_back(oldest.slot);
+        window.pop_front();
+    }
+    const bench::TimePoint end = bench::now();
+    result.wall_s = bench::seconds_between(start, end);
+
+    const auto outcome = ctx.shutdown(ShutdownPolicy::drain);
+    if (!outcome.has_value()) {
+        result.ok = false;
+        result.failure = "shutdown failed";
+    }
+    result.stats_delta = stats_diff(stats, before);
+    return result;
+}
