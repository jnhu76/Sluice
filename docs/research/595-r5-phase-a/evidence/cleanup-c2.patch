+                    facts.owner_pass_sampled = shared.owner_pass_sampled;
                 }
                 auto outcome = adapter->submit(std::span<const ReadOp>(ready.data(), ready.size()),
                                                accepted, facts);
diff --git a/bench/r3_ready_batch.hpp b/bench/r3_ready_batch.hpp
