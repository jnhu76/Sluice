+PhaseResult run_fsync_phase(const PipelineParams& params, const std::string& path) {
+    sluice::async::detail::research595::trace::next_phase();
+    PhaseResult result;
+    auto opened = File::open(path, rw_open_existing());
+    if (!opened.has_value()) {
+        result.ok = false;
+        result.failure = "open failed: " + describe(opened.error());
+        return result;
+    }
+    File file = std::move(opened).value();
+
+    AsyncStats stats;
+    std::string backend_failure;
+    auto context =
+        make_context(*params.backend, params.depth, params.workers, backend_failure, nullptr);
+    if (!context.has_value()) {
+        result.ok = false;
+        result.failure = "NOT_RUN_WITH_REASON: " + backend_failure;
+        return result;
+    }
+    AsyncIoContext ctx = std::move(*context);
+
+    const std::size_t blocks = (kFixtureBytes - params.block_size) / params.block_size;
+    std::vector<std::byte> dirty(params.block_size);
+    bench::fill_pattern(dirty.data(), params.block_size, 0);
+
+    RequestScope scope(ctx, params.depth, ScopeCleanupPolicy::drain);
+    std::deque<ScopeTicket<void>> window;
+    std::size_t submitted = 0;
+    std::size_t completed = 0;
+    const double start = bench::now_ns() * 1e-9;
+    while (completed < params.request_count) {
+        while (window.size() < params.depth && submitted < params.request_count) {
+            const std::uint64_t offset =
+                static_cast<std::uint64_t>(submitted % blocks) * params.block_size;
+            auto wrote = sluice::blocking::write_all_at(
+                file, offset, std::span<const std::byte>(dirty.data(), params.block_size));
+            if (!wrote.has_value() || !wrote.value().complete()) {
+                result.ok = false;
+                result.failure = "dirty write failed";
+                return result;
+            }
+            sluice::async::SyncDataOp op;
+            op.file = NativeFileRef(file);
+            ++result.counters.submits;
+            auto ticket = scope.submit_sync_data(op);
+            if (!ticket.has_value()) {
+                if (ticket.error().code == IoError::Code::would_block) {
+                    ++result.counters.would_block;
+                    break;
+                }
+                result.ok = false;
+                result.failure = "submit failed: " + describe(ticket.error());
+                return result;
+            }
+            window.push_back(ticket.value());
+            ++submitted;
+        }
+        if (window.empty()) {
+            result.ok = false;
+            result.failure = "fsync pipeline stalled with an empty window";
+            return result;
+        }
+        ++result.counters.waits;
+        auto waited = scope.wait_for(window.front(), kWaitDeadline);
+        if (!waited.has_value()) {
+            result.ok = false;
+            result.failure = "wait failed: " + describe(waited.error());
+            return result;
+        }
+        if (waited.value() != ScopeWaitStatus::ready) {
+            result.ok = false;
+            result.failure = "wait outcome was not ready";
+            return result;
+        }
+        RequestObservation<void> observed = scope.take(window.front());
+        window.pop_front();
+        if (observed.readiness != RequestReadiness::ready || !observed.result.has_value()) {
+            result.ok = false;
+            result.failure = "fsync result was not successful";
+            return result;
+        }
+        ++result.ops;
+        ++completed;
+    }
+    auto finished = scope.finish();
+    if (!finished.has_value()) {
+        result.ok = false;
+        result.failure = "scope finish failed";
+        return result;
+    }
+    const double end = bench::now_ns() * 1e-9;
+    result.wall_s = end - start;
+    auto shutdown = ctx.shutdown(ShutdownPolicy::drain);
+    if (!shutdown.has_value()) {
+        result.ok = false;
+        result.failure = "shutdown failed";
+        return result;
+    }
+    result.stats_delta = stats;
+    return result;
+}
